rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Both custom claims below are set by Cloud Functions (Admin SDK) —
    // `staff` by onStaffWritten whenever a /staff doc is written, `tenantId`
    // by provisionTenantLogin when the owner creates a tenant's login. They
    // live in the ID token itself, so no cross-service Firestore lookup is
    // needed here (that path proved unreliable for write rules).
    function isStaff() {
      return request.auth != null && request.auth.token.staff == true;
    }

    function isOwnTenant(tenantId) {
      return request.auth != null && request.auth.token.tenantId == tenantId;
    }

    // Size-only cap. An earlier version also required
    // `contentType.matches('image/.*')`, but that check proved unreliable
    // in practice (content-type isn't always what's expected depending on
    // the picker/platform) and caused silent 403s for legitimate uploads —
    // not worth it when staff visually review every one of these anyway.
    function isUnder10MB() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // /tenant_docs/{pgId}/{tenantId}/{fileName} — ID proofs, agreements,
    // photos. Staff can read/write any; a tenant can upload (not overwrite
    // others') to their own folder once email-verified, and read their own
    // uploads back — needed because the client calls getDownloadURL()
    // right after uploading, which is a read, not a write.
    match /tenant_docs/{pgId}/{tenantId}/{fileName} {
      allow read, write: if isStaff();
      allow read: if isOwnTenant(tenantId);
      allow write: if isOwnTenant(tenantId)
        && request.auth.token.email_verified == true
        && isUnder10MB();
    }

    // /pg_qr/{pgId}/{fileName} — the PG's static UPI payment QR code image.
    // Staff upload it; any signed-in user (incl. the tenant app) can view it.
    match /pg_qr/{pgId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isStaff();
    }

    // /payment_claim_receipts/{pgId}/{tenantId}/{fileName} — screenshots a
    // tenant uploads from their own app as proof of a QR payment. Staff
    // read them for review; the uploading tenant can also read their own
    // (the client calls getDownloadURL() right after uploading — a read,
    // not a write, so this was silently blocking every upload).
    match /payment_claim_receipts/{pgId}/{tenantId}/{fileName} {
      allow read: if isStaff() || isOwnTenant(tenantId);
      allow write: if request.auth != null && isUnder10MB();
    }

    // /maintenance_photos/{pgId}/{tenantId}/{fileName} — optional photo a
    // tenant attaches to a maintenance ticket. Same shape as payment claim
    // receipts: staff read all, the tenant reads/writes their own.
    match /maintenance_photos/{pgId}/{tenantId}/{fileName} {
      allow read: if isStaff() || isOwnTenant(tenantId);
      allow write: if isOwnTenant(tenantId) && isUnder10MB();
    }
  }
}
